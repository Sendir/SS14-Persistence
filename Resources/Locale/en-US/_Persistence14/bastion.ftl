paragon-key-slot = paragon key
analysis-console-paragon-locked = The Paragon Artifact needs a key.

# Defense-pulse console readout (configurable bands live on the Paragon's BastionPulse component).
analysis-console-pulse-status = Defense: {$state}
# Shown while the ruin is tearing down (Paragon completed / lifetime expired).
analysis-console-teardown = Bastion ruin pulled back to where it came from in {$seconds}s...
bastion-pulse-dormant = Dormant — no intruders detected
bastion-pulse-distant = Charging
bastion-pulse-near = Discharge nearing
bastion-pulse-imminent = Discharge imminent
bastion-pulse-complete = Dormant — the Paragon is spent
paragon-key-inserted = The key sinks in and dissolves. The Paragon Artifact shudders awake — its graph is unlocked.
paragon-key-wrong = The slot rejects it — this is not the key attuned to this Paragon.

# Printed by the Bastion console on extract; the number is the disk's actual point value (default disks
# are named/described "(1000)" regardless of value, which is misleading for the x20 Paragon payout).
bastion-research-disk-name = research point disk ({$points})
bastion-research-disk-desc = A disk for the R&D server containing {$points} points.

bastion-resync-success = The artifact shudders violently — something vast has been dragged into this dimension.
bastion-resync-failed = The artifact strains, then cracks apart. The resync collapsed.

# Shared runtime messages for all spawnbastionruin* commands.
cmd-spawnbastionruin-no-player = You must be attached to an entity to use this command.
cmd-spawnbastionruin-no-space = Could not find open space near you to spawn the Bastion Ruin.
cmd-spawnbastionruin-success = Spawned {$defense}-defense Bastion Ruin {$ruin} + Paragon key {$artifact} at ({$x}, {$y}). Teleport there with: tp {$x} {$y}

cmd-spawnbastionruinrandom-desc = Spawn a Bastion Ruin with a RANDOM defense + a ready key at your feet.
cmd-spawnbastionruinrandom-help = Usage: spawnbastionruinrandom
cmd-spawnbastionruinartifacts-desc = Spawn a Bastion Ruin with the Artifacts defense + a ready key at your feet.
cmd-spawnbastionruinartifacts-help = Usage: spawnbastionruinartifacts
cmd-spawnbastionruinanomalies-desc = Spawn a Bastion Ruin with the Anomalies defense + a ready key at your feet.
cmd-spawnbastionruinanomalies-help = Usage: spawnbastionruinanomalies
cmd-spawnbastionruinmobs-desc = Spawn a Bastion Ruin with the Mobs defense + a ready key at your feet.
cmd-spawnbastionruinmobs-help = Usage: spawnbastionruinmobs
